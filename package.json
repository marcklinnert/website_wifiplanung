{
  "name": "wifi-planung",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:toolchain:browsers": "node scripts/check-toolchain.mjs --browsers",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:css": "node scripts/check-css-radius.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm check:toolchain && pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:contrast && pnpm build && pnpm check:css && pnpm check:toolchain:browsers && pnpm test:e2e"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
